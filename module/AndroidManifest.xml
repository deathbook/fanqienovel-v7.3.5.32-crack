<?xml version="1.0" encoding="utf-8"?>
<!--
  LSPosed / Xposed module for the Lesson-2 FanQie Novel sample.

  There is deliberately no Activity: Xposed modules are driven entirely by the
  meta-data below plus assets/xposed_init, and an empty launcher would only add
  something for a detector to notice.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.deathbook.fanqie.crack"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="33" />

    <application
        android:label="番茄小说破解 FanQieCrack"
        android:description="@string/module_description"
        android:allowBackup="false"
        android:hasCode="true" />

    <!-- ================= Xposed / LSPosed wiring ================= -->
    <meta-data
        android:name="xposedmodule"
        android:value="true" />
    <meta-data
        android:name="xposeddescription"
        android:value="@string/module_description" />
    <meta-data
        android:name="xposedminversion"
        android:value="93" />
    <meta-data
        android:name="xposedsharedprefs"
        android:value="true" />
    <!-- Pre-select the target so the user does not have to find it by hand. -->
    <meta-data
        android:name="xposedscope"
        android:resource="@array/xposedscope" />

</manifest>
